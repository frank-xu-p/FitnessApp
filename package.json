{
  "name": "fitness-app",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "pnpm --filter @fitness-app/mobile test",
    "playground": "pnpm --filter @fitness-app/backend exec tsx scripts/run-playground.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""

  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0",
    "prettier": "^3.3.0",
    "eslint": "^9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "pnpm": {
    "neverBuiltDependencies": ["esbuild"]
  }
}
