{
  "expo": {
    "name": "Fitness App",
    "slug": "fitness-app",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "fitnessapp",
    "platforms": ["ios", "android"],


    "backgroundColor": "#ffffff",
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },


    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fitness.app"
    },
    "android": {
      "package": "com.fitness.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],

    "experiments": {
      "typedRoutes": true
    }
  }
}
